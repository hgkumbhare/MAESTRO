    # Returns: ["alex.smith@company.com", "alex.johnson@company.com"]  (Ambiguous match)
    
    find_email_address("Nonexistent Name")
    # Returns: []  (No match found)
    
    find_email_address("")
    # Returns: "Name not provided."

