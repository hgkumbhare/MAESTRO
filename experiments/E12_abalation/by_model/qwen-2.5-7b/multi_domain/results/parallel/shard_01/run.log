  # Get the total visits count since October 27, 2023                           
  time_min = "2023-10-27"                                                       
  time_max = "2023-11-30"                                                       
  visits_count = total_visits_count(time_min, time_max)                         
                                                                                
  # Check if total visits was less than 21 at any time                          
  visits_less_than_21 = False                                                   
  for day, count in visits_count.items():                                       
      if count < 21:                                                            
          visits_less_than_21 = True                                            
          break                                                                 
                                                                                
  # If total visits was less than 21 at any time, create a new task             
  if visits_less_than_21:                                                       
      # Get the person with the most completed front end tasks                  
      front_end_tasks = search_tasks(list_name="Completed", board="Front end")  
      most_completed_front_end_tasks = max(front_end_tasks, key=lambda x:       
  x['task_name'])['assigned_to_email']                                          
                                                                                
      # Create a new task                                                       
      task_id = create_task(                                                    
          task_name="Improve total visits",                                     
          assigned_to_email=most_completed_front_end_tasks,                     
          list_name="Backlog",                                                  
          due_date="2023-12-01",  # Next Friday                                 
          board="Front end"                                                     
      )                                                                         
