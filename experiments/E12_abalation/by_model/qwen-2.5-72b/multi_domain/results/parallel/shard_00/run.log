      # Search for emails from Kofi in the past 4 days                          
      import datetime                                                           
      today = datetime.date.today()                                             
      four_days_ago = today - datetime.timedelta(days=4)                        
      four_days_ago_str = four_days_ago.strftime("%Y-%m-%d")                    
      print(f"Searching for emails from Kofi sent after                         
  {four_days_ago_str}...")                                                      
                                                                                
      emails = search_emails(query=kofi_emails[0], date_min=four_days_ago_str,  
