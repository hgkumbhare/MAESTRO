  from collections import defaultdict                                           
                                                                                
  # Initialize a dictionary to count overdue tasks per person                   
  overdue_task_counts = defaultdict(int)                                        
                                                                                
  # Count overdue tasks for each person                                         
  for task in overdue_tasks:                                                    
      assigned_to_email = task['assigned_to_email']                             
      overdue_task_counts[assigned_to_email] += 1                               
                                                                                
  # Find the person with the fewest overdue tasks                               
  person_with_fewest_overdue_tasks = min(overdue_task_counts,                   
  key=overdue_task_counts.get)                                                  
  print(person_with_fewest_overdue_tasks)                                       
