  # Calculate the start date for the last 4 weeks                               
  from datetime import datetime, timedelta                                      
                                                                                
  end_date = datetime.strptime("2023-11-30", "%Y-%m-%d")                        
  start_date = end_date - timedelta(weeks=4)                                    
                                                                                
  # Format dates as strings                                                     
  time_min = start_date.strftime("%Y-%m-%d")                                    
  time_max = end_date.strftime("%Y-%m-%d")                                      
                                                                                
  # Get traffic counts for referral and social media                            
  referral_traffic = traffic_source_count(time_min=time_min,                    
  time_max=time_max, traffic_source="referral")                                 
  social_media_traffic = traffic_source_count(time_min=time_min,                
  time_max=time_max, traffic_source="social media")                             
                                                                                
  # Check if referral traffic is greater than social media traffic              
  if sum(referral_traffic.values()) > sum(social_media_traffic.values()):       
      print("Creating bar charts for referral and social media traffic.")       
      create_plot(time_min=time_min, time_max=time_max,                         
  value_to_plot="visits_referral", plot_type="bar")                             
      create_plot(time_min=time_min, time_max=time_max,                         
  value_to_plot="visits_social_media", plot_type="bar")                         
  else:                                                                         
      print("Referral traffic is not greater than social media traffic. No      
