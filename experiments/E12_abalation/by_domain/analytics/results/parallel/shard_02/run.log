  # Function to create a text-based bar chart                                   
  def create_text_bar_chart(data, title):                                       
      max_value = max(data.values())                                            
      scale = 50  # Scale for the bar length                                    
      chart = f"{title}\n"                                                      
      for date, count in data.items():                                          
          bar_length = int((count / max_value) * scale)                         
          chart += f"{date}: {'#' * bar_length} ({count})\n"                    
      return chart                                                              
                                                                                
  # Create text-based bar charts                                                
  social_media_chart = create_text_bar_chart(social_media_visits, "Social       
  Media Visits")                                                                
  search_engine_chart = create_text_bar_chart(search_engine_visits, "Search     
  Engine Visits")                                                               
                                                                                
  # Combine the charts for display                                              
  final_chart = f"{social_media_chart}\n{search_engine_chart}"                  
  print(final_chart)                                                            
