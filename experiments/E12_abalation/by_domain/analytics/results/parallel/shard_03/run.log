  # Create a simple ASCII line chart representation for total visits in         
  November                                                                      
  def create_ascii_line_chart(dates, visits):                                   
      max_visits = max(visits)                                                  
      chart = ""                                                                
                                                                                
      for i in range(max_visits, 0, -1):                                        
          line = f"{i:2} | "  # Line number                                     
          for visit in visits:                                                  
              if visit >= i:                                                    
                  line += " * "  # Mark for visits                              
              else:                                                             
                  line += "   "  # No mark                                      
          chart += line + "\n"                                                  
                                                                                
      # Add the x-axis labels                                                   
      chart += "    " + "---" + "----" * len(visits) + "\n"                     
      chart += "     " + " ".join(dates) + "\n"                                 
                                                                                
      return chart                                                              
                                                                                
  # Prepare the ASCII line chart                                                
