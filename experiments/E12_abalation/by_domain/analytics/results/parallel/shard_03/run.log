  social_media_total = sum(map(int, social_media_counts_int))                   
                                                                                
  summary = f"""                                                                
  Traffic Source Summary Over the Last 5 Weeks:                                 
  -----------------------------------------------                               
  Search Engine Visits: {search_engine_total}                                   
  Social Media Visits: {social_media_total}                                     
                                                                                
