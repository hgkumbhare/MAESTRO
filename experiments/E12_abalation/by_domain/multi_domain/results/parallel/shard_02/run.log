  # Define the start time for the meeting (first available time after 9 AM)     
  start_time = datetime.combine(tomorrow_date, datetime.strptime("09:00:00",    
  "%H:%M:%S").time())                                                           
                                                                                
  # Define the duration of the meeting in minutes                               
  duration = 30                                                                 
                                                                                
  # Calculate the end time of the meeting                                       
  end_time = start_time + timedelta(minutes=duration)                           
                                                                                
  # Check if the end time is before 6 PM                                        
  if end_time.time() <= datetime.strptime("18:00:00", "%H:%M:%S").time():       
      meeting_start = start_time.strftime("%Y-%m-%d %H:%M:%S")                  
      meeting_end = end_time.strftime("%Y-%m-%d %H:%M:%S")                      
  else:                                                                         
      meeting_start = None                                                      
      meeting_end = None                                                        
                                                                                
