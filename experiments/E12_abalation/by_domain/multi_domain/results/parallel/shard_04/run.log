  from collections import defaultdict                                           
                                                                                
  # Initialize a dictionary to count overdue tasks for each assignee            
  overdue_counts = defaultdict(int)                                             
                                                                                
  # Iterate through the tasks to count overdue tasks                            
  for task in tasks:                                                            
      assigned_to = task['assigned_to_email']                                   
      overdue_counts[assigned_to] += 1                                          
                                                                                
  # Find the person with the fewest overdue tasks                               
  fewest_overdue_person = min(overdue_counts, key=overdue_counts.get)           
  fewest_overdue_count = overdue_counts[fewest_overdue_person]                  
                                                                                
  print(f"Person with the fewest overdue tasks: {fewest_overdue_person} with    
  {fewest_overdue_count} overdue tasks.")                                       
