  from collections import defaultdict                                           
                                                                                
  # Initialize a dictionary to count overdue tasks per user                     
  overdue_count = defaultdict(int)                                              
                                                                                
  # Count overdue tasks for each user                                           
  for task in tasks:                                                            
      assigned_email = task['assigned_to_email']                                
      overdue_count[assigned_email] += 1                                        
                                                                                
  # Find the user with the fewest overdue tasks                                 
  min_overdue_user = min(overdue_count, key=overdue_count.get)                  
  min_overdue_count = overdue_count[min_overdue_user]                           
                                                                                
  print(f"User with the fewest overdue tasks: {min_overdue_user} with           
  {min_overdue_count} overdue tasks.")                                          
