  from datetime import datetime                                                 
                                                                                
  # Today's date                                                                
  today = datetime.strptime("2023-11-30", "%Y-%m-%d")                           
                                                                                
  # List to hold customer overdue counts                                        
  overdue_counts = []                                                           
                                                                                
  # Check each customer for overdue tasks                                       
  for customer in customers:                                                    
      follow_up_date = datetime.strptime(customer['follow_up_by'], "%Y-%m-%d")  
      overdue_count = 0                                                         
                                                                                
      # If the follow-up date is before today, it's overdue                     
      if follow_up_date < today:                                                
          overdue_count += 1                                                    
                                                                                
      overdue_counts.append((customer['customer_name'], overdue_count))         
                                                                                
  # Find the customer with the fewest overdue tasks                             
  fewest_overdue_customer = min(overdue_counts, key=lambda x: x[1])             
  print(fewest_overdue_customer)                                                
