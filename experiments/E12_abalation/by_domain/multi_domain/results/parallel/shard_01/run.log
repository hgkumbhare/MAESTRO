  from collections import defaultdict                                           
                                                                                
  # Initialize a dictionary to count overdue tasks per email                    
  overdue_count = defaultdict(int)                                              
                                                                                
  # Count overdue tasks for each assigned email                                 
  for task in overdue_tasks:                                                    
      assigned_email = task['assigned_to_email']                                
      overdue_count[assigned_email] += 1                                        
                                                                                
  # Find the person with the fewest overdue tasks                               
  min_overdue_email = min(overdue_count, key=overdue_count.get)                 
  min_overdue_count = overdue_count[min_overdue_email]                          
                                                                                
  print(f"Email with the fewest overdue tasks: {min_overdue_email} (Count:      
  {min_overdue_count})")                                                        
