  from collections import defaultdict                                           
                                                                                
  # Initialize a dictionary to count overdue tasks for each person              
  overdue_counts = defaultdict(int)                                             
                                                                                
  # Iterate through the tasks and count overdue tasks for each assigned email   
  for task in tasks:                                                            
      assigned_email = task['assigned_to_email']                                
      overdue_counts[assigned_email] += 1                                       
                                                                                
  # Find the person with the fewest overdue tasks                               
  min_overdue_person = min(overdue_counts, key=overdue_counts.get)              
  min_overdue_count = overdue_counts[min_overdue_person]                        
                                                                                
  print(f"Person with the fewest overdue tasks: {min_overdue_person} with       
  {min_overdue_count} overdue tasks.")                                          
