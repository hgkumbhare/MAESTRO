  # Initialize a dictionary to count overdue tasks per email                    
  overdue_count = defaultdict(int)                                              
                                                                                
  # Count the overdue tasks for each assigned email                             
  for task in overdue_tasks:                                                    
      assigned_email = task['assigned_to_email']                                
      overdue_count[assigned_email] += 1                                        
                                                                                
  # Find the email with the fewest overdue tasks                                
  fewest_overdue_email = min(overdue_count, key=overdue_count.get)              
  fewest_overdue_count = overdue_count[fewest_overdue_email]                    
                                                                                
  print(f"Email with fewest overdue tasks: {fewest_overdue_email} (Count:       
  {fewest_overdue_count})")                                                     
